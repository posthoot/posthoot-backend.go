# This is an example secrets file. Copy this to secrets.yaml and fill in your values.
# IMPORTANT: Never commit secrets.yaml to version control!
# Use kubectl create secret or a secrets management tool in production.

apiVersion: v1
kind: Secret
metadata:
  name: posthoot-secrets
  namespace: posthoot
type: Opaque
stringData:
  # Database Configuration
  postgres-host: "your-postgres-host"
  postgres-user: "your-postgres-user"
  postgres-password: "your-postgres-password"
  postgres-db: "your-postgres-db"
  
  # JWT Configuration
  jwt-secret: "your-jwt-secret-key-change-this"
  
  # S3 Configuration (optional)
  s3-bucket-name: ""
  s3-region: ""
  s3-access-key: ""
  s3-secret-key: ""
  s3-endpoint: ""
  
  # SMTP Configuration (optional)
  smtp-host: ""
  smtp-port: "587"
  smtp-user: ""
  smtp-password: ""
  smtp-from-email: ""
  smtp-provider: "CUSTOM"
  
  # Crypto Configuration (optional)
  private-key: ""
  
  # Monitor Configuration (optional)
  discord-webhook-url: ""

